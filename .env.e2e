# Used only by the end-to-end tests (npm run e2e): the fake backend answers this address.
VITE_API_URL=http://api.test
VITE_TURNSTILE_SITE_KEY=
VITE_SUPPORT_EMAIL=support@example.com
# Map tiles come from the fake backend too (404s), so the tests never reach the internet.
VITE_MAP_TILES=http://api.test/tiles/{z}/{x}/{y}.png
# Photo links point at the fake backend too (the CSP allows images from here)
PHOTO_ORIGIN=http://api.test
