# Copy to .env.local and fill in. Never commit .env.local.
# The backend's address (no trailing slash).
VITE_API_URL=http://localhost:8080
# Cloudflare Turnstile site key (public). Leave empty when the backend has no TURNSTILE_SECRET_KEY.
VITE_TURNSTILE_SITE_KEY=
# Where salon partners write for help (shown on More).
VITE_SUPPORT_EMAIL=support@clozest.in
# Map tiles for the salon's location pin (OpenStreetMap by default; fine for low traffic, see its tile policy).
VITE_MAP_TILES=
# The kirana switch (build-time): off by default, the app is for salons only (no kirana screen, route or call).
# 'true' turns the kirana side on. Must match the backend's KIRANA_ENABLED (off, its kirana paths answer 404 KIRANA_OFF).
VITE_KIRANA_ENABLED=false
